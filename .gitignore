# Workspace repo (Neovatus/NeoERP): only what lives nowhere else.
# Code repos have their own GitHub repos; never duplicate them here.
/NeoERP-App/
/NeoERP-BackEnd/
# Generated output and scratch.
/Claude outputs/
/_scratch/
# Project state files are not shared through this repo.
/PROJECT-STATE*.md
# Inbox listener runtime files.
docs/inbox/.listen-*
docs/inbox/.paused-*
# OS and editor noise.
.DS_Store
~$*
*.log
# Override ~/.gitignore_global for this repo: these belong here.
!CLAUDE.md
!docs/agents/
!docs/agents/**
!.codex/
!.codex/**

# Shared Claude settings (Stop hook: inbox listener check). Global ignore hides .claude/.
!.claude/
.claude/*
!.claude/settings.json
!.claude/launch.json
